# Server
DATABASE_PATH=./data/vitrine.sqlite
BACKUP_DIR=./data/backups
STORAGE_DIR=./data/storage
PORT=3000
NODE_ENV=development

# Auth
AUTH_SECRET=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Gateway webhooks — one var per gateway, e.g. WEBHOOK_SECRET_RAZORPAY=
WEBHOOK_SECRET_GATEWAY=

# Media storage — local disk by default; set all four S3_* to use MinIO/S3 instead
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=

# CORS (comma-separated origins, credentials mode)
ALLOWED_ORIGINS=

# PDF renderer — optional pin to a Chrome/Chromium/Edge binary; falls back to PATH
BUN_CHROME_PATH=
