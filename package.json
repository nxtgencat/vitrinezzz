{
  "name": "bold-ferret",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "verify:db": "bun run scripts/verify-db.ts",
    "verify:rbac": "bun run scripts/verify-rbac.ts",
    "verify:immutability": "bun run scripts/verify-immutability.ts",
    "verify:hygiene": "bun run scripts/verify-hygiene.ts",
    "verify:deps": "bun run scripts/verify-deps.ts",
    "test:rbac": "bun test test/rbac.test.ts",
    "test:core": "bun test test/core.test.ts",
    "ci": "bun run typecheck && bun run verify:db && bun run verify:rbac && bun run test:rbac && bun run verify:immutability && bun run verify:hygiene && bun run verify:deps && bun run test:core"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
