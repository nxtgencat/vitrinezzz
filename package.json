{
  "name": "bold-ferret",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "typecheck": "bunx tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "verify:db": "bun run scripts/verify-db.ts",
    "verify:rbac": "bun run scripts/verify-rbac.ts",
    "verify:immutability": "bun run scripts/verify-immutability.ts",
    "verify:hygiene": "bun run scripts/verify-hygiene.ts",
    "verify:deps": "bun run scripts/verify-deps.ts",
    "verify:stock": "bun run scripts/verify-stock.ts",
    "verify:audit": "bun run scripts/verify-audit.ts",
    "verify:realtime": "bun run scripts/verify-realtime.ts",
    "smoke:catalog": "bun run scripts/smoke-catalog.ts",
    "smoke:media": "bun run scripts/smoke-media.ts",
    "smoke:inventory": "bun run scripts/smoke-inventory.ts",
    "smoke:purchasing": "bun run scripts/smoke-purchasing.ts",
    "smoke:sales": "bun run scripts/smoke-sales.ts",
    "smoke:storefront": "bun run scripts/smoke-storefront.ts",
    "smoke:payments": "bun run scripts/smoke-payments.ts",
    "smoke:returns": "bun run scripts/smoke-returns.ts",
    "smoke:fulfillment": "bun run scripts/smoke-fulfillment.ts",
    "test:rbac": "bun test test/rbac.test.ts",
    "test:core": "bun test test/core.test.ts",
    "test:stock": "bun test test/stock.test.ts",
    "test:sales": "bun test test/sales.test.ts",
    "test:payments": "bun test test/payments.test.ts",
    "test:returns": "bun test test/returns.test.ts",
    "test:realtime": "bun test test/realtime.test.ts",
    "test:pdf": "bun test test/pdf.test.ts",
    "ci": "bun run typecheck && bun run verify:db && bun run verify:rbac && bun run test:rbac && bun run verify:immutability && bun run verify:hygiene && bun run verify:deps && bun run verify:stock && bun run verify:audit && bun run verify:realtime && bun run smoke:catalog && bun run smoke:media && bun run smoke:inventory && bun run smoke:purchasing && bun run smoke:sales && bun run smoke:storefront && bun run smoke:payments && bun run smoke:returns && bun run smoke:fulfillment && bun run test:core && bun run test:stock && bun run test:sales && bun run test:payments && bun run test:returns && bun run test:realtime && bun run test:pdf"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@hono/zod-validator": "^0.9.0",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
